# 复制为 .env 后按本机修改；.env 已在 .gitignore，禁止入库
APP_NAME=ComplianceGuard
DEBUG=false

# MySQL（库不存在时 python -m scripts.init_db 会自建）
DATABASE_URL=mysql+pymysql://root:<your_password>@localhost:3306/compliance_guard?charset=utf8mb4
DB_ECHO=false
# 测试库（pytest 用，事务回滚不留数据）；留空则自动用 <库名>_test
TEST_DATABASE_URL=

# JWT：用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=<change_me_at_least_16_chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 前端开发地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# bcrypt 成本因子（测试可设 4 加速）
BCRYPT_ROUNDS=12

# 元/百万 token；空值回退 MODEL_PRICES，仍缺失则 cost=null（未计价）
JUDGE_INPUT_PRICE_PER_M=
JUDGE_OUTPUT_PRICE_PER_M=

# embedding每百万token单价；未配置则全链路总费用为null
# text-embedding-v3 文本输入，元/百万 tokens，官方价 2026-11（非 Batch File）
EMBEDDING_PRICE_PER_M=0.5
REPORT_USE_LLM=false

# 单次读操作超时（秒），urllib并非总请求截止时间
JUDGE_TIMEOUT=180

JUDGE_ENABLE_THINKING=false

REDTEAM_ENABLE_THINKING=true

EMBEDDING_ENABLE_THINKING=false

JUDGE_PASS_THINKING_PARAM=true

# 模型后端：urllib（默认，已实测全绿）| langchain（ChatOpenAI 走同一兼容端点）
# 判定编排两种后端下完全相同，只换"这一次 chat 调用交给谁"；出问题改回 urllib 即回退。
LLM_BACKEND=urllib

# MCP 调用方式：inline（默认，业务内链复用同一实现）| client（真经 stdio 协议调用工具）
# client 模式已实测：握手、list_tools 列出 8 个工具、经协议调用 db_query_rules 断言通过
# （命令：python -m backend.mcp_server.server --selftest-mcp）。
# 但本机上**经协议第一次调用 rag_search_law 会挂到超时**（>90s 不返回），第二次起 7s 正常；
# 同一套检索在独立进程里只要 6.7s，关掉 chroma 遥测、排除 tiktoken 后仍未消失，原因未查明。
# 所以 client 模式只用于协议层验收，不作默认，也不要在演示时打开。
MCP_MODE=inline
# 协议调用超时（秒）
MCP_CALL_TIMEOUT=120

# 素材摄取（商家上传的文档/海报/录音）
# 相对路径按项目根解析；两个目录都刻意放项目盘——C 盘只剩几 GB，
# 模型权重默认会写进 C:\Users\<user>\.cache，会在下载中途把磁盘挤满。
UPLOAD_DIR=data/uploads
MODEL_DIR=data/models

# 可选引擎开关：关掉后对应格式直接 422 并说明原因，不会假装支持
PARSE_OCR_ENABLED=true
PARSE_ASR_ENABLED=true
